# Client Environment Variables for GitHub Pages Deployment

# Production API URL (replace with your actual server URL)
VITE_API_BASE_URL=https://your-server-domain.com

# Production Socket.IO URL (replace with your actual server URL)
VITE_SOCKET_URL=https://your-server-domain.com

# For local development, use:
# VITE_API_BASE_URL=http://localhost:4000
# VITE_SOCKET_URL=http://localhost:4000
